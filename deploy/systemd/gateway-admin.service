[Unit]
Description=MCP Gateway Admin (API + UI)
After=network.target redis.service gateway-proxy.service
Wants=redis.service

[Service]
Type=simple
User=mcp
Group=mcp
WorkingDirectory=/opt/mcp-gateway/gateway-admin
Environment=REDIS_URL=redis://127.0.0.1:6379/0
Environment=ADMIN_PORT=8081
Environment=GATEWAY_PROXY_METRICS_URL=http://127.0.0.1:9465/metrics
EnvironmentFile=-/etc/mcp-gateway/admin.env
ExecStart=/opt/mcp-gateway/gateway-admin/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8081
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
