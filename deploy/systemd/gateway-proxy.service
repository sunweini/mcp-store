[Unit]
Description=MCP Gateway Proxy
After=network.target redis.service
Wants=redis.service

[Service]
Type=simple
User=mcp
Group=mcp
WorkingDirectory=/opt/mcp-gateway/gateway-proxy
Environment=REDIS_URL=redis://127.0.0.1:6379/0
Environment=GATEWAY_PORT=8080
Environment=PROMETHEUS_PORT=9465
Environment=OTEL_EXPORTER_OTLP_ENDPOINT=
EnvironmentFile=-/etc/mcp-gateway/proxy.env
ExecStart=/opt/mcp-gateway/gateway-proxy/.venv/bin/python server.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
