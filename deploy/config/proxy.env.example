# gateway-proxy / 搜索服务 共享配置
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# brave-mcp 出网代理，空则不使用；正式环境 api.search.brave.com 直连
# 不通（IPv4 被墙/IPv6 不通）必须配置，如:
# SEARCH_PROXY=http://10.16.12.12:7890
# 注意:brave-mcp 与 gateway-admin 两容器都读此变量(brave key 探活
# 同样要直连 brave API);tavily/serpapi 直连通,不受此变量影响
SEARCH_PROXY=

