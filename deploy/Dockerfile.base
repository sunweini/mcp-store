# MCP Gateway 基础镜像:Python 运行时 + uv + Node.js(给 admin-ui 构建)
# 所有服务镜像 FROM mcp-base:latest
FROM python:3.12-slim

# 阿里云 apt 源(生产服务器无法访问 deb.debian.org)
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list

# 编译依赖 + Node.js(用 apt nodejs,避免 NodeSource 外部源不可达)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc build-essential curl ca-certificates nodejs npm \
    && rm -rf /var/lib/apt/lists/*

# uv(从官方镜像复制二进制,ghcr 可达)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# uv + npm 国内镜像(容器内构建时 pypi/npmjs 可能不可达)
ENV UV_DEFAULT_INDEX=https://mirrors.aliyun.com/pypi/simple/
RUN npm config set registry https://registry.npmmirror.com

WORKDIR /app
